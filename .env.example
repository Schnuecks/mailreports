# Mailbox that receives the reports (rua= and TLS-RPT addresses)
IMAP_HOST=mail.example.org
IMAP_USER=dmarc@example.org
# IMAP_PASSWORD=...            # better: IMAP_PASSWORD_FILE=/run/secrets/imap_password
# IMAP_PORT=993
# IMAP_SECURITY=ssl            # ssl, starttls
# IMAP_FOLDER=INBOX
# IMAP_MOVE_TO=Processed       # empty: processed mails are only flagged
# IMAP_ERROR_FOLDER=           # empty: mails without a report are only flagged
# IMAP_READONLY=false          # true: never change the mailbox (next to another reader)
# FETCH_INTERVAL=900           # seconds

# Appearance
# APP_TITLE=DMARC reports
# LOGO_URL=https://example.org/logo.svg
# DEFAULT_LANGUAGE=            # de, en; empty: browser language
# DOMAINS=example.org,example.net   # order and selection on the overview
TZ=Europe/Berlin

# Push notifications (Pushover)
# PUSHOVER_TOKEN=...           # or PUSHOVER_TOKEN_FILE
# PUSHOVER_USER=...            # or PUSHOVER_USER_FILE
# NOTIFY_COOLDOWN_HOURS=24
# BASE_URL=https://dmarc.example.org

# Sign-in to the page: either a password (ADMIN_PASSWORD_FILE, see compose.yaml) ...
# ADMIN_PASSWORD=...            # the password or an Argon2 hash (python -m mailreports hash-password)
# COOKIE_SECURE=true            # session cookie only over HTTPS (set it behind an HTTPS proxy)
# ... or a login proxy (then ADMIN_PASSWORD is not used)
# AUTH_HEADER=Remote-User
# ALLOWED_GROUPS=admins
# TRUSTED_PROXIES=172.20.0.5   # the proxy's own address, not the whole network

# Lookups
# DNS_LOOKUPS=true
# GEOIP_DIR=/geoip
