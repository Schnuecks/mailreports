# Mailbox that receives the reports (rua= and TLS-RPT addresses)
IMAP_HOST=mail.example.org
IMAP_USER=dmarc@example.org
# IMAP_PASSWORD=...            # better: IMAP_PASSWORD_FILE=/run/secrets/imap_password
# IMAP_PORT=993
# IMAP_SECURITY=ssl            # ssl, starttls
# IMAP_FOLDER=INBOX
# IMAP_MOVE_TO=Processed       # empty: processed mails are only flagged
# IMAP_ERROR_FOLDER=           # empty: mails without a report are only flagged
# IMAP_READONLY=false          # true: never change the mailbox (next to another reader)
# FETCH_INTERVAL=900           # seconds
# RETENTION_DAYS=0             # delete reports older than this; 0 keeps them

# Appearance
# APP_TITLE=DMARC reports
# THEME=neutral        # or olive
# LOGO_URL=https://example.org/logo.svg
# DEFAULT_LANGUAGE=            # de, en, fr, es, it, nl; empty: browser language
# DOMAINS=example.org,example.net   # order and selection on the overview
TZ=Europe/Berlin

# Push notifications (Pushover)
# PUSHOVER_TOKEN=...           # or PUSHOVER_TOKEN_FILE
# PUSHOVER_USER=...            # or PUSHOVER_USER_FILE
# NTFY_URL=https://ntfy.sh/my-topic
# WEBHOOK_URL=https://example.org/hook
# SMTP_HOST=mail.example.org    # with SMTP_FROM and NOTIFY_EMAIL: notifications by email
# SMTP_FROM=dmarc@example.org
# NOTIFY_EMAIL=admin@example.org
# DIGEST=weekly                 # weekly summary to all channels
# NOTIFY_COOLDOWN_HOURS=24
# METRICS_TOKEN=...             # read /api/metrics and /metrics without signing in
# BASE_URL=https://dmarc.example.org

# Sign-in with built-in accounts (default). The first account is created on the page with
# the setup code from the log, or from ADMIN_PASSWORD on the first start.
# PUBLIC_URL=https://dmarc.example.org   # needed behind a reverse proxy (passkeys, SSO)
# ADMIN_PASSWORD=...            # optional; password or Argon2 hash (python -m mailreports hash-password)
# SECRET_KEY=...                # encrypts authenticator keys in the database; keep it
# Single sign-on (OpenID Connect)
# OIDC_ISSUER=https://auth.example.org
# OIDC_CLIENT_ID=mailreports
# OIDC_CLIENT_SECRET=...        # or OIDC_CLIENT_SECRET_FILE
# OIDC_NAME=Authelia
# OIDC_ADMIN_GROUP=admins
# ... or a login proxy instead of accounts
# AUTH_HEADER=Remote-User
# ALLOWED_GROUPS=admins
# TRUSTED_PROXIES=172.20.0.5   # the proxy's own address, not the whole network

# Lookups
# DNS_LOOKUPS=true
# GEOIP_DIR=/geoip
